# 密钥与本地数据不进镜像
.env
*.env
!docker-compose.yml

# Python 缓存
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/

# 运行时数据（用卷持久化，不打包）
projects/
output/
logs/

# 前端本地构建产物与依赖（多阶段构建在镜像内重新 build，不打进镜像）
webapp/frontend/dist/
webapp/frontend/node_modules/

# 根目录临时脚本
_*.py

# 测试与开发文件
tests/
pytest.ini

# 系统与编辑器
.DS_Store
Thumbs.db
.idea/
.vscode/
