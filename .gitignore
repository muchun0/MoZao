# ===== 密钥与敏感文件（绝不提交） =====
.env
.llm_encrypt.key

# ===== Python 缓存/虚拟环境 =====
__pycache__/
*.pyc
.pytest_cache/
*.egg-info/
.venv/
venv/

# ===== 运行时数据（不入库） =====
logs/
projects/
output/
webapp/*.db*
# ===== 需求分析文档 =====
docs/*
# AI 知识库三件套入库（Agent 免全盘扫描的固定知识，见 AGENTS.md §0）
!docs/architecture.md
!docs/filemap.md
!docs/decisions.md

# ===== 收款码等运营私有素材（不入库） =====
webapp/webui/payment_qr2.png
webapp/webui/payment_qr.png

# ===== 临时脚本/工具 =====
_*.py
_*.sh
*.tar.gz
# 但保留Python包初始化文件（_*.py 会误匹配 __init__.py）
!**/__init__.py

# ===== IDE =====
.idea/
.vscode/
.workbuddy/

# AI agent rules (local only)
AGENTS.md

stderr.log
stdout.log

# 测试缓存与报告（测试用例 tests/ 随仓库维护，入库）
.pytest_cache/
ux_report/

# 本地配置（含密钥，不入库）
config.yaml
# 营销素材
marketing/

# ===== 运行日志（本地） =====
_server_*.log
webapp*.log

# ===== 发版打包与上传分片 =====
novel_master*.zip
novel_master.part*
novel_upgrade.zip
up_part_*.txt

# ===== AI 生成草稿缓存 =====
draft_*_folder/

# Claude Code 规则（local only，与 AGENTS.md 同策略）
CLAUDE.md
