# Caddy 配置：mozao.click HTTPS 反代 + IP http 直连回退
# 用法：caddy run --config /etc/caddy/Caddyfile --adapter caddyfile
# 说明：mozao.click 走 HTTPS（Let's Encrypt 自动签发/续签）；
#       旧 IP http://47.114.41.136 直接反代、不跳转（IP 无证书，https 无法提供）

mozao.click {
    # 反代到 Docker 容器映射的服务端口
    reverse_proxy 127.0.0.1:8000
    encode gzip
}

# 旧 IP http 直连（内测/兼容已收藏旧地址的用户）
:80 {
    reverse_proxy 127.0.0.1:8000
    encode gzip
}
